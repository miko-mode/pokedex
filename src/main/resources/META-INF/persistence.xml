<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="pokedexPU">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Här listar vi våra entiteter -->
        <class>com.models.Pokemon</class>
        <class>com.models.Attack</class>

        <properties>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <!-- Kontrollera mappningen, ändra inte schemat -->
            <!--<property name="hibernate.hbm2ddl.auto" value="validate"/>-->

            <property name="hibernate.connection.isolation" value="2"/>
            <!--
              1 = READ UNCOMMITTED
              2 = READ COMMITTED
              4 = REPEATABLE READ
              8 = SERIALIZABLE
            -->
            <property name="hibernate.connection.url" value="jdbc:postgresql://localhost:5432/pokedex"/>
            <property name="hibernate.connection.username" value="postgres"/>
            <property name="hibernate.connection.password" value="admin"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

        </properties>

    </persistence-unit>

</persistence>